# SHADOWCOMM / ASTRA legacy research and messaging configuration
# Never commit a real .env file or production credentials.
#
# Local simulations may use the development defaults with a warning.
# Production deployments MUST set SHADOWCOMM_ENV=production and supply unique
# values for the session secret, endpoint tokens, and (on a new database) seed
# passwords. Production mode fails closed if values are missing, short, known
# demo values, or obvious placeholders.

SHADOWCOMM_ENV=development

# Flask session + receipt-HMAC secret.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SHADOWCOMM_SECRET_KEY=generate_a_random_32_byte_hex_string_here

# Legacy research-only AES-CTR key. Final-Project/app.py is blocked in production
# because it reuses a fixed CTR initial counter; do not use it for field traffic.
# Replace before any local AES research; this setting is not production approval.
SHADOWCOMM_AES_KEY=replace_with_32_hex_characters_for_local_research_only

# CORS origins (comma-separated; do not use '*' in production)
SHADOWCOMM_CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001,http://127.0.0.1:5050,http://localhost:5050

# Server network binding
SHADOWCOMM_HOST=127.0.0.1
SHADOWCOMM_PORT=5050

# Endpoint tokens. For development, known demo tokens may be used with a warning.
# Production requires unique values of at least 32 characters and refuses to
# start if an existing database contains different tokens; rotate explicitly.
SHADOWCOMM_TOKEN_ENDPOINT_A=replace_with_unique_random_token_for_endpoint_a
SHADOWCOMM_TOKEN_ENDPOINT_B=replace_with_unique_random_token_for_endpoint_b

# Initial users for a NEW database only. Production requires values of at least
# 16 characters. Existing admin/operator accounts still need their demo
# passwords rotated before switching an existing database to production.
SHADOWCOMM_ADMIN_PASSWORD=replace_with_unique_initial_admin_password
SHADOWCOMM_OPERATOR_PASSWORD=replace_with_unique_initial_operator_password

# SQLite database location
SHADOWCOMM_DB_PATH=shadowcomm_messaging.db
