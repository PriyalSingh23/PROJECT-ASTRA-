# SHADOWCOMM / SHADOWLINK FIELD CONFIGURATION TEMPLATE
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL

# Flask / Session Secret Key (Generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SHADOWCOMM_SECRET_KEY=generate_a_random_32_byte_hex_string_here

# AES-128 / AES-256 Symmetric Encryption Key (32 hex characters = 16 bytes for AES-128, or 64 hex characters for AES-256)
SHADOWCOMM_AES_KEY=000102030405060708090a0b0c0d0e0f

# CORS Allowed Origins (Comma-separated list; DO NOT use '*' in production)
SHADOWCOMM_CORS_ORIGINS=http://127.0.0.1:5050,http://localhost:5050

# Server Network Binding
SHADOWCOMM_HOST=127.0.0.1
SHADOWCOMM_PORT=5050

# Pre-Shared Device Authentication Tokens for Controlled Pilot
SHADOWCOMM_TOKEN_ENDPOINT_A=token-pilot-alpha-94e82b
SHADOWCOMM_TOKEN_ENDPOINT_B=token-pilot-bravo-31a7c4

# SQLite Database Location
SHADOWCOMM_DB_PATH=shadowcomm_messaging.db
